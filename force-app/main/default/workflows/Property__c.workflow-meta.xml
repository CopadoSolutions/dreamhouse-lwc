<?xml version="1.0" encoding="UTF-8" ?>
<Workflow xmlns="http://soap.sforce.com/2006/04/metadata">
    <alerts>
        <fullName>Property_Now_Available_Alert</fullName>
        <description
        >Email the property owner when a listing goes Available</description>
        <protected>false</protected>
        <recipients>
            <type>owner</type>
        </recipients>
        <senderType>CurrentUser</senderType>
        <template>unfiled$public/Property_Now_Available</template>
    </alerts>
    <fieldUpdates>
        <fullName>Stamp_Date_Contracted</fullName>
        <description
        >Set Date Contracted to today when the listing is contracted</description>
        <field>Date_Contracted__c</field>
        <formula>TODAY()</formula>
        <name>Stamp Date Contracted</name>
        <notifyAssignee>false</notifyAssignee>
        <operation>Formula</operation>
        <protected>false</protected>
        <reevaluateOnChange>false</reevaluateOnChange>
    </fieldUpdates>
    <fieldUpdates>
        <fullName>Stamp_Date_Closed</fullName>
        <description
        >Set Date Closed to today when the listing is closed</description>
        <field>Date_Closed__c</field>
        <formula>TODAY()</formula>
        <name>Stamp Date Closed</name>
        <notifyAssignee>false</notifyAssignee>
        <operation>Formula</operation>
        <protected>false</protected>
        <reevaluateOnChange>false</reevaluateOnChange>
    </fieldUpdates>
    <rules>
        <fullName>Property Contracted Stamp Date</fullName>
        <actions>
            <name>Stamp_Date_Contracted</name>
            <type>FieldUpdate</type>
        </actions>
        <active>true</active>
        <description
        >LEGACY: simple field update. Stamps Date Contracted when Status becomes Contracted.</description>
        <formula>ISPICKVAL(Status__c, &quot;Contracted&quot;)</formula>
        <triggerType>onCreateOrTriggeringUpdate</triggerType>
    </rules>
    <rules>
        <fullName>Property Closed Stamp Date</fullName>
        <actions>
            <name>Stamp_Date_Closed</name>
            <type>FieldUpdate</type>
        </actions>
        <active>true</active>
        <description
        >LEGACY: field update. OVERLAPS with the Property_Stamp_Closed_Date before-save Flow already in the org. Migrating naively would double-stamp.</description>
        <formula>ISPICKVAL(Status__c, &quot;Closed&quot;)</formula>
        <triggerType>onCreateOrTriggeringUpdate</triggerType>
    </rules>
    <rules>
        <fullName>Property Now Available Notification</fullName>
        <actions>
            <name>Property_Now_Available_Alert</name>
            <type>Alert</type>
        </actions>
        <active>true</active>
        <description
        >LEGACY: email alert. Notifies the owner when Status becomes Available.</description>
        <formula>ISPICKVAL(Status__c, &quot;Available&quot;)</formula>
        <triggerType>onCreateOrTriggeringUpdate</triggerType>
    </rules>
    <rules>
        <fullName>Property Stale Listing Follow Up</fullName>
        <active>false</active>
        <description
        >LEGACY: time-dependent action (inactive until Default Workflow User is set in Setup). 90 days after Date Listed, if still Available, create a follow-up task. Needs Scheduled Path in Flow.</description>
        <formula>ISPICKVAL(Status__c, &quot;Available&quot;)</formula>
        <triggerType>onCreateOrTriggeringUpdate</triggerType>
        <workflowTimeTriggers>
            <actions>
                <name>Review_Stale_Listing</name>
                <type>Task</type>
            </actions>
            <offsetFromField>Property__c.Date_Listed__c</offsetFromField>
            <timeLength>90</timeLength>
            <workflowTimeTriggerUnit>Days</workflowTimeTriggerUnit>
        </workflowTimeTriggers>
    </rules>
    <tasks>
        <fullName>Review_Stale_Listing</fullName>
        <assignedToType>owner</assignedToType>
        <description
        >This listing has been Available for 90 days. Review pricing and marketing.</description>
        <dueDateOffset>3</dueDateOffset>
        <notifyAssignee>false</notifyAssignee>
        <priority>High</priority>
        <protected>false</protected>
        <status>Not Started</status>
        <subject>Review stale listing</subject>
    </tasks>
</Workflow>
